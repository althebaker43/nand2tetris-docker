/**
 * A library of commonly used mathematical functions.
 * Note: Jack compilers implement multiplication and division using OS method calls.
 */
class Math {

    static Array pow2;
    static int divTestX;

    /** Initializes the library. */
    function void init() {
        let pow2 = Array.new(16);
        let pow2[ 0] = 1;
        let pow2[ 1] = 2;
        let pow2[ 2] = 4;
        let pow2[ 3] = 8;
        let pow2[ 4] = 16;
        let pow2[ 5] = 32;
        let pow2[ 6] = 64;
        let pow2[ 7] = 128;
        let pow2[ 8] = 256;
        let pow2[ 9] = 512;
        let pow2[10] = 1024;
        let pow2[11] = 2048;
        let pow2[12] = 4096;
        let pow2[13] = 8192;
        let pow2[14] = 16384;
        let pow2[15] = ~(32767);
        return;
    }

    /** Returns the absolute value of x. */
    function int abs(int x) {
        if (x < 0) {
            return -x;
        }
        return x;
    }

    function int getBit(int x, int i) {

        if (i > 15) {
            return 0;
        }

        if (x & pow2[i]) {
            return 1;
        }
        else {
            return 0;
        }
    }

    function int setBit(int x, int i) {

        if (i > 15) {
            return x;
        }

        return x | pow2[i];
    }

    function int clearBit(int x, int i) {

        if (i > 15) {
            return x;
        }

        return x & (~pow2[i]);
    }

    /** Returns the product of x and y. 
     *  When a Jack compiler detects the multiplication operator '*' in the 
     *  program's code, it handles it by invoking this method. In other words,
     *  the Jack expressions x*y and multiply(x,y) return the same value.
     */
    function int multiply(int x, int y) {

        var int sum;
        var int shiftedX;
        var int i;

        let shiftedX = x;
        let i = 0;

        while (i < 16) {

            if (Math.getBit(y, i)) {

                let sum = sum + shiftedX;
            }

            let shiftedX = shiftedX + shiftedX;
            let i = i + 1;
        }

        return sum;
    }

    /** Returns the integer part of x/y.
     *  When a Jack compiler detects the multiplication operator '/' in the 
     *  program's code, it handles it by invoking this method. In other words,
     *  the Jack expressions x/y and divide(x,y) return the same value.
     */
    function int divide(int x, int y) {

        var int absX, absY;
        var int q;

        if (x = 0) {
            return 0;
        }

        if (y = 0) {
            return 0;
        }

        let absX = Math.abs(x);
        let absY = Math.abs(y);

        let q = Math.divideRec(absX, absY);

        if (((x < 0) & (y > 0)) | ((x > 0) & (y < 0))) {
            let q = -q;
        }
        
        return q;
    }

    function int divideRec(int x, int y) {

        var int q;

        // Check if y is greater than x or if y overflows
        if ((y > x) | (y < 0)) {
            let divTestX = 0;
            return 0;
        }

        let q = Math.divideRec(x, (y + y));

        if (q & 1) {
            let divTestX = divTestX + (y + y);
        }

        if ((x - divTestX) < y) {
            return (q + q);
        }
        else {
            return ((q + q) + 1);
        }
    }

    /** Returns the integer part of the square root of x. */
    function int sqrt(int x) {

        var int y;
        var int testY, testYSqr;
        var int i;

        let y = 0;
        let testY = 0;
        let testYSqr = 0;
        let i = 7;

        while ((i > 0) | (i = 0)) {

            let testY = y + pow2[i];
            let testYSqr = testY * testY;

            if ((testYSqr > 0) & ((testYSqr = x) | (testYSqr < x))) {
                let y = testY;
            }

            let i = i - 1;
        }

        return y;
    }

    /** Returns the greater number. */
    function int max(int a, int b) {

        if (a > b) {
            return a;
        }
        else {
            return b;
        }
    }

    /** Returns the smaller number. */
    function int min(int a, int b) {

        if (a < b) {
            return a;
        }
        else {
            return b;
        }
    }
}
